{"sections":{"image_with_text_X3K6yA":{"type":"image-with-text","blocks":{"heading_HJFpaW":{"type":"heading","settings":{"heading":"Pup Nado Collection","heading_size":"h2"}},"text_wVngzK":{"type":"text","settings":{"text":"<p><strong>A tornado of pups, paws, and pure chaos. <\/strong><\/p>","text_style":"body"}},"button_eXdjWd":{"type":"button","settings":{"button_label":"Shop Pup-Nado Mugs 🌪️","button_link":"shopify:\/\/collections\/pup-nado","button_style_secondary":true}},"custom_liquid_yrWgA3":{"type":"custom_liquid","disabled":true,"settings":{"custom_liquid":"{%- assign deadline_str = '2025-11-01 23:59 -0600' -%}\n\n{%- assign now_s = 'now' | date: '%s' -%}\n{%- assign end_s = deadline_str | date: '%s' -%}\n{%- assign diff_s = end_s | minus: now_s -%}\n\n{%- if diff_s > 0 -%}\n  {%- assign days = diff_s | divided_by: 86400 -%}\n  {%- assign rem = diff_s | modulo: 86400 -%}\n  {%- if rem > 0 -%}{% assign days = days | plus: 1 %}{%- endif -%}\n  <div class=\"pmz-mini-countdown\" aria-live=\"polite\" title=\"Ends Nov 1, 11:59 PM MT\">\n    Only <strong>{{ days }}<\/strong> more day{% if days != 1 %}s{% endif %}\n  <\/div>\n{%- else -%}\n  <div class=\"pmz-mini-countdown ended\" aria-live=\"polite\">🎃 Final day — don’t miss it<\/div>\n{%- endif -%}\n\n<style>\n  \/* Remove the big default block gap under the button in this section *\/\n  .image-with-text__content > .pmz-mini-countdown-wrap{ margin-top:8px !important; }\n  \/* If your theme adds inner margins to custom-liquid content, neutralize them *\/\n  .pmz-mini-countdown-wrap .pmz-mini-countdown{ margin-top:0 !important; }\n\n  \/* Clean pill badge *\/\n  .pmz-mini-countdown{\n    --pmz-fg:#374151;          \/* text gray *\/\n    --pmz-pill:#FFF6F0;        \/* soft orange tint *\/\n    --pmz-pill-border:#FFE0CC; \/* border *\/\n    --pmz-accent:#CC5500;      \/* brand orange *\/\n    --pmz-shadow:0 1px 0 rgba(0,0,0,.05), 0 6px 20px rgba(204,85,0,.06);\n\n    display:inline-flex; align-items:center; justify-content:center; gap:.5rem;\n    padding:8px 14px; border-radius:999px;\n    background:var(--pmz-pill); border:1px solid var(--pmz-pill-border);\n    color:var(--pmz-fg); text-align:center;\n    font-size:15px; line-height:1.35; font-variant-numeric:tabular-nums;\n    white-space:nowrap; box-shadow:var(--pmz-shadow);\n  }\n  \/* Single pumpkin via CSS only *\/\n  .pmz-mini-countdown::before{ content:\"🎃\"; display:inline-block; transform:translateY(1px); }\n  .pmz-mini-countdown strong{ color:var(--pmz-accent); font-weight:900; letter-spacing:.1px; }\n\n  \/* Urgency pulse for last 3 days *\/\n  .pmz-mini-countdown.is-urgent{ background:#FFEFE6; border-color:#FFCBAA; animation:pmzPulse 1.8s ease-in-out infinite; }\n  @keyframes pmzPulse{ 0%,100%{box-shadow:var(--pmz-shadow)} 50%{box-shadow:0 1px 0 rgba(0,0,0,.06),0 0 0 8px rgba(204,85,0,.08)} }\n\n  \/* Ended style if you keep the message after deadline *\/\n  .pmz-mini-countdown.ended{ background:#111; color:#fff; border-color:transparent; }\n\n  \/* Mobile *\/\n  @media (max-width:480px){\n    .pmz-mini-countdown{ font-size:14px; padding:7px 12px; }\n  }\n<\/style>\n\n<script>\n\/* Add 'is-urgent' class when days <= 3 (purely for CSS pulse) *\/\n(function(){\n  var el = document.currentScript.previousElementSibling.previousElementSibling; \/\/ <style> then <div>\n  var wrap = document.querySelector('.pmz-mini-countdown');\n  if(!wrap) return;\n  var text = wrap.textContent || '';\n  var m = text.match(\/\\b(\\d+)\\b\/);\n  if(m && parseInt(m[1],10) <= 3){ wrap.classList.add('is-urgent'); }\n})();\n<\/script>"}}},"block_order":["heading_HJFpaW","text_wVngzK","button_eXdjWd","custom_liquid_yrWgA3"],"custom_css":[".button,.button--primary,.btn,.shopify-payment-button__button--unbranded {--alpha-button-background: 1 !important; --alpha-button-border: 1 !important; background-color: #000000 !important; color: #ffffff !important; border-color: transparent !important; opacity: 1 !important;}",".button:hover,.button--prima