lection":"pomeranian-1"}},"featured_collection_kUkkqd":{"type":"featured_collection","settings":{"collection":"pug"}}},"block_order":["featured_collection_qKFtJe","featured_collection_kUkkqd"],"disabled":true,"name":"t:sections.collection-list.presets.name","settings":{"title":"","heading_size":"h1","image_ratio":"square","columns_desktop":4,"color_scheme":"","show_view_all":false,"columns_mobile":"2","swipe_on_mobile":false,"padding_top":36,"padding_bottom":36}},"custom_liquid_dmyAe7":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  \/* Full-bleed on mobile, centered container on larger screens *\/\n  .pf{\n    width:100%;\n    max-width:900px; \/* cap width on wider screens *\/\n    margin:clamp(8px,1.5vw,16px) auto clamp(16px,2.5vw,28px);\n    background:#fff;\n    border:1px solid #eee;\n    border-radius:16px;\n    padding:clamp(16px,2vw,24px) clamp(16px,2vw,24px) 0; \/* standard comfy padding desktop\/tablet *\/\n    box-shadow:0 6px 24px rgba(0,0,0,.06);\n    text-align:center; \/* center all inline elements & text *\/\n  }\n\n  .pf h3{margin:0 0 6px;font-size:clamp(18px,2vw,24px)}\n  .pf p{margin:0 0 10px;color:#555}\n\n  \/* Keep inputs nicely centered with a comfortable max width *\/\n  .in{\n    flex:1 1 0;\n    max-width:640px;\n    margin:0 auto;             \/* center the input blocks *\/\n    width:100%;\n  }\n\n  .f-row{\n    display:flex;\n    gap:8px;\n    align-items:center;\n    justify-content:center;    \/* center the button row *\/\n  }\n\n  .in input{\n    width:100%;height:46px;padding:0 14px;\n    border:1px solid #ddd;border-radius:999px;background:#fafafa;\n    outline:0;transition:border .18s,box-shadow .18s,background .18s;\n    text-align:left;           \/* keep typing left-aligned even though container is centered *\/\n  }\n  .in input:focus{border-color:#111;box-shadow:0 0 0 3px rgba(17,17,17,.12);background:#fff}\n\n  .bt{\n    height:46px;padding:0 18px;border-radius:999px;border:1px solid #111;\n    background:#111;color:#fff;font-weight:700;letter-spacing:.2px;\n    white-space:nowrap;cursor:pointer\n  }\n\n  .hp{position:absolute;left:-9999px;opacity:0}\n\n  .help{margin:8px 0 0;font-size:13px;color:#666}\n\n  .ok,.er{\n    border-radius:10px;padding:10px 12px;font-weight:600;margin:10px 0 0;\n    text-align:center;         \/* center success\/error messages *\/\n  }\n  .ok{background:#f2fbf5;color:#1f7a39;border:1px solid #d7f0dd}\n  .er{background:#fff4f2;color:#9c2a11;border:1px solid #ffd7cf}\n\n  \/* Mobile niceties: go truly edge-to-edge with small safe padding *\/\n  @media (max-width:720px){\n    html,body{overflow-x:hidden} \/* avoid sideways scroll on full-bleed *\/\n    .pf{\n      max-width:none; \/* let it span *\/\n      width:100vw;    \/* edge-to-edge *\/\n      margin:0;       \/* no outer margins on mobile *\/\n      border-left:0;\n      border-right:0; \/* blend with page edge *\/\n      border-radius:0;\/* standard full-bleed look *\/\n      padding:16px clamp(12px,4vw,18px) 0; \/* little padding *\/\n    }\n    .f-row{flex-wrap:wrap;justify-content:center}\n    .bt{width:100%;height:48px}\n    .in input{height:48px}\n  }\n<\/style>\n\n<div class=\"pf\">\n  <h3>Stay in the loop<\/h3>\n  <p>Fresh drops, limited runs, and secret discounts. 🐾<\/p>\n\n  {% form 'customer', id: 'pmz-news' %}\n    {% if form.posted_successfully? %}\n      <div class=\"ok\" role=\"status\">Thanks! You’re on the list. 🙌<\/div>\n    {% else %}\n      {% if form.errors %}<div class=\"er\" role=\"alert\">{{ form.errors | default_errors }}<\/div>{% endif %}\n\n      <div class=\"in\" style=\"margin-bottom:8px\">\n        <input id=\"pmz-email\" type=\"email\" name=\"contact[email]\" required placeholder=\"Email\" autocomplete=\"email\" aria-label=\"Email\">\n        <input type=\"text\" name=\"contact[trap]\" class=\"hp\" tabindex=\"-1\" autocomplete=\"off\">\n      <\/div>\n\n      <div class=\"in\" style=\"margin-bottom:10px\">\n        <input id=\"pmz-breed\" type=\"text\" minlength=\"3\" placeholder=\"Don’t see your breed? Leave it here (optional)\" aria-label=\"Breed request (optional)\">\n      <\/div>\n\n      <div class=\"f-row\">\n        <input type=\"hidden\" name=\"contact[tags]\" value=\"newsletter, footer-signup\">\n        <button type=\"submit\" class=\"bt\">Sign Up<\/button>\n      <\/div>\n\n      <p class=\"help\">Join for 10% off your first mug + updates.<\/p>\n    {% endif %}\n  {% endform %}\n<\/div>\n\n<script>\n  (function(){\n    var f=document.getElementById('pmz-news');\n    if(!f) return;\n    f.addEventListener('submit',function(e){\n      var trap=f.querySelector('input[name=\"contact[trap]\"]');\n      if(trap && trap.value.trim()){\n        e.preventDefault();\n        return;\n      }\n      \/* your existing logic can continue here *\/\n    });\n  })();\n\n<\/script>","color_scheme":"","padding_top":40,"padding_bottom":52}}},"order":["main","collection_list_UezCgm","collection_list_ctJTB8","collection_list_c9KBnV","custom_liquid_dmyAe7"]}